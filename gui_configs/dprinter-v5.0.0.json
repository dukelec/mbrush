{
    // fmt: [c]: string, b: int8_t, B: uint8_t, h: int16_t, H: uint16_t, i: int32_t, I: uint32_t, f: float
    // show: 0: normal, 1: hex, 2: bytes
    "reg": {
        "list": [
            [ 0x0000, 2, "H", 1, "magic_code", "Magic code 0xcdcd, marks a valid register table in flash" ],
            [ 0x0002, 2, "H", 1, "conf_ver", "Register table version, high byte: major, low byte: minor" ],
            [ 0x0004, 1, "B", 1, "conf_from", "0: default config, 1: all from flash, 2: default from bt_mac on (only major version matches)" ],
            [ 0x0005, 1, "B", 0, "do_reboot", "Write 1: reboot to bootloader, 2: normal reboot", [0, 2] ],
            [ 0x0007, 1, "b", 0, "save_conf", "Write 1 to save current config to flash", [0, 1] ],

            [ 0x0009, 1, "b", 0, "dbg_en", "1: report debug prints to host, 0: do not report" ],

            [ 0x000c, 1, "B", 1, "bus_cfg_mac", "RS-485 address, range: 0~254", [0, 254] ],
            [ 0x0010, 4, "I", 0, "bus_cfg_baud_l", "Baud rate of the first byte, default 2 Mbps" ],
            [ 0x0014, 4, "I", 0, "bus_cfg_baud_h", "Baud rate of the following bytes, default 20 Mbps" ],
            [ 0x0018, 2, "[B]", 1, "bus_cfg_filter_m", "Multicast address filter" ],
            [ 0x001a, 1, "B", 0, "bus_cfg_mode", "0: traditional half-duplex, 1: arbitration, 2: break sync", [0, 2] ],
            [ 0x001c, 2, "H", 0, "bus_cfg_tx_permit_len", "Idle time before tx is permitted, unit: bit time" ],
            [ 0x001e, 2, "H", 0, "bus_cfg_max_idle_len", "Max idle wait time in break sync mode, unit: bit time" ],
            [ 0x0020, 1, "B", 0, "bus_cfg_tx_pre_len", "TX_EN lead time before tx, unit: bit time, ignored in arbitration mode" ],
            [ 0x0024, 1, "B", 1, "bt_mac", "RS-485 address of the BLE board" ],
            [ 0x0026, 2, "H", 0, "auto_spit_period", "Auto spit period in seconds, 0: disabled; needs USB power to stay on" ],
            [ 0x0028, 2, "H", 0, "auto_spit_timer", "Auto spit countdown in seconds, reset by printer operations" ],
            [ 0x002a, 1, "B", 1, "dbg_raw_msk", "1: enable waveform debug" ],
            [ 0x002c, 16, "{H,H}", 1, "dbg_raw", "Waveform debug data sources: {address, length} × 4" ],

            [ 0x0070, 4, "f", 0, "c_t0", "Cartridge temperature calibration (unused)" ],
            [ 0x0074, 16, "[f]", 0, "c_r0", "Cartridge temperature calibration (unused)" ],
            [ 0x00b6, 1, "B", 0, "enc_cfg", "bit1: input mode, 0: A/B, 1: STEP/DIR; bit0: swap A/B or invert DIR; applied after save & reboot", [0, 3] ],
            [ 0x00b7, 1, "B", 0, "enc_div", "Set by the dpt file; bit7: input × 2; bit[6:0]: input ÷ (val + 1)" ],
            [ 0x00b8, 2, "H", 1, "enc_trig_f", "Encoder position to start printing when moving forward" ],
            [ 0x00ba, 2, "H", 1, "enc_trig_b", "Encoder position to start printing when moving backward" ],
            [ 0x00bc, 2, "H", 0, "const_period", "Non-zero: constant speed printing, period in µs" ],
            [ 0x00be, 1, "b", 0, "print_dir", "Set by the dpt file; 0: print when moving forward, 1: backward", [0, 1] ],

            [ 0x0141, 1, "B", 1, "p_state", "bit[2:0] = 0: idle; bit7: temp error, 6: no ink (unused), 5: cartridge invalid, 4: no cartridge, 3: no data, 2: printing, 1: spitting, 0: warming" ],
            [ 0x0142, 2, "H", 1, "enc_val", "Position encoder value, cleared by e_ctrl" ],
            [ 0x0144, 4, "[B]", 1, "c_state", "One byte per cartridge, CMYK order; bit4: 0 temp low, 1 temp high; bit3: temp error, 2: no ink (unused), 1: invalid, 0: not detected" ],
            [ 0x0148, 16, "[f]", 0, "c_ink_count", "Ink usage record, CMYK order, unit: mL" ],
            [ 0x0158, 16, "[f]", 0, "c_temperature", "Printhead temperature, CMYK order" ],
            [ 0x0168, 4, "f", 0, "temperature", "Ambient temperature" ],
            [ 0x016c, 4, "i", 0, "prt_enc_pos", "Print move position, see Print Position in the Readme" ],
            [ 0x0170, 4, "i", 0, "prt_dat_pos", "File print position, negative while warming, see Print Position in the Readme" ],
            [ 0x0174, 4, "f", 0, "voltage", "Single cell LiPo battery voltage (V)" ],
            [ 0x0178, 4, "f", 0, "current", "Printhead current (mA)" ],
            [ 0x017c, 1, "b", 0, "dc_online", "1: charger connected" ],
            [ 0x01ac, 1, "B", 1, "p_ctrl", "Write 0x01: warm, 0x02: spit, 0x04: print, 0x10: cancel job", [[0, 2], [4, 4], [16, 16], [128, 128]] ],
            [ 0x01ad, 1, "B", 1, "d_ctrl", "Write 0x01: clear unsubmitted data, 0x02: submit file, 0x10: clear all data", [[0, 2], [16, 16]] ],
            [ 0x01ae, 1, "B", 1, "e_ctrl", "Write 0x10: clear enc_val", [[0, 0], [16, 16]] ],
            [ 0x01af, 1, "B", 1, "c_ctrl", "Write 0x08: calibrate cartridge temperature (unused)", [[0, 0], [8, 8]] ],

            [ 0x01f0, 16, "[I]", 1, "c_id", "Cartridge unique id" ],
            [ 0x0240, 4, "I", 1, "psram_f_start", "Start address of the submitted file (8 MB ring buffer)" ],
            [ 0x0244, 4, "I", 1, "psram_f_end", "End address of the submitted file, equals start: no file" ],
            [ 0x0248, 4, "I", 1, "psram_w_offset", "End address of the file being written" ],
            [ 0x024c, 1, "B", 1, "p14_cnt", "Sequence cnt of file transfer port 0x14" ],
            [ 0x024d, 1, "B", 0, "p14_err", "Port 0x14 error, 0: none, 1: cnt error, 2: invalid file header, 3: corrupted data" ],

            [ 0x0298, 1, "B", 0, "ink_rec_bank", "Ink record bank, for debugging only" ],
            [ 0x0299, 1, "B", 0, "ink_rec_idx", "Ink record index, for debugging only" ]
        ],

        // section titles over the list: the register a section starts with -> title
        "seps": {
            "magic_code": "System",
            "dbg_en": "Debug",
            "bus_cfg_mac": "Bus (save & reboot to apply)",
            "bt_mac": "Bluetooth",
            "auto_spit_period": "Auto spit",
            "dbg_raw_msk": "Waveform debug",
            "c_t0": "Cartridge",
            "enc_cfg": "Encoder",
            "p_state": "Status",
            "p_ctrl": "Control",
            "c_id": "Cartridge id",
            "psram_f_start": "File transfer",
            "ink_rec_bank": "Ink record (debug)"
        },

        // button groups
        "sets": {
            "reg": {
                "r": [["magic_code","conf_from"],["do_reboot","save_conf"],["dbg_en"],["bus_cfg_mac","bus_cfg_tx_pre_len"],["bt_mac"],["auto_spit_period","auto_spit_timer"],["dbg_raw_msk","dbg_raw"],["c_t0","c_r0"],["enc_cfg"],["enc_div","enc_trig_b"],["const_period"],["print_dir"],["p_state","c_state"],["c_ink_count","temperature"],["prt_enc_pos","prt_dat_pos"],["voltage","dc_online"],["p_ctrl","c_ctrl"],["c_id"],["psram_f_start","psram_w_offset"],["p14_cnt","p14_err"],["ink_rec_bank","ink_rec_idx"]],
                "w": [["magic_code"],["conf_ver"],["do_reboot"],["save_conf"],["dbg_en"],["bus_cfg_mac","bus_cfg_tx_pre_len"],["bt_mac"],["auto_spit_period"],["auto_spit_timer"],["dbg_raw_msk"],["dbg_raw"],["c_t0","c_r0"],["enc_cfg"],["enc_div","enc_trig_b"],["const_period"],["print_dir"],["c_ink_count"],["p_ctrl"],["d_ctrl"],["e_ctrl"],["c_ctrl"]]
            }
        },

